# Single source of truth for CLI tool versions used in CI.
#
# Binaries are verified against the SHA-256 committed here, not just the
# vendor's checksum file at download time: if a release is later tampered
# with (as happened to trivy-action tags in March 2026), CI fails closed.
# To bump: change the version, copy the linux/amd64 hash from the vendor's
# release checksum file, and confirm it by hashing the downloaded artifact.

TERRAFORM_VERSION=1.16.5
HELM_VERSION=v4.3.0
KUBECTL_VERSION=v1.34.12
