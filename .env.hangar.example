# Copy to .env.hangar (gitignored). `make bootstrap` writes the first block for you.
# Format: KEY=value, no quotes, no `export`. Read by make and the bootstrap scripts.

# --- Written by bootstrap ---------------------------------------------------
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_LOCATION=eastus2
TF_STATE_RG=rg-hangar-tfstate
TF_STATE_SA=
TF_STATE_CONTAINER=tfstate
HANGAR_OPERATOR_OBJECT_ID=
HANGAR_CI_OBJECT_ID=
AZURE_CLIENT_ID=
GITHUB_REPO=

# --- Optional, set by hand --------------------------------------------------
# Your public IP(s) allowed to SSH to the legacy VM, comma-separated (curl -s ifconfig.me).
HANGAR_ALLOWED_SSH_CIDRS=
# Defaults to ~/.ssh/id_ed25519.pub
HANGAR_SSH_PUBLIC_KEY_FILE=
# Comma-separated emails for platform alerts.
HANGAR_ALERT_EMAILS=
# Restrict the AKS API server (leave empty while CI uses GitHub-hosted runners).
HANGAR_API_AUTHORIZED_CIDRS=
