# Stand-in for the Azure legacy VM: Ubuntu 24.04 with systemd and sshd, an
# admin user in `sudo` (as on Azure), reached by Ansible over real SSH.
FROM ubuntu:24.04

ARG SSH_PUBKEY
ENV container=docker DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
       systemd systemd-sysv dbus openssh-server sudo python3 python3-apt \
       curl ca-certificates iproute2 iptables \
    && rm -rf /var/lib/apt/lists/* \
    # Units that make no sense inside a container
    && systemctl mask systemd-udevd.service systemd-udev-trigger.service \
       getty.target console-getty.service systemd-logind.service \
    # Plain sshd service rather than socket activation, so port 22 is always up
    && systemctl disable ssh.socket && systemctl enable ssh.service \
    && useradd -m -s /bin/bash -G sudo hangaradmin \
    && echo 'hangaradmin ALL=(ALL) NOPASSWD:ALL' > /etc/sudoers.d/hangaradmin \
    && chmod 0440 /etc/sudoers.d/hangaradmin \
    && install -d -m 0700 -o hangaradmin -g hangaradmin /home/hangaradmin/.ssh \
    && echo "${SSH_PUBKEY}" > /home/hangaradmin/.ssh/authorized_keys \
    && chown hangaradmin:hangaradmin /home/hangaradmin/.ssh/authorized_keys \
    && chmod 0600 /home/hangaradmin/.ssh/authorized_keys

STOPSIGNAL SIGRTMIN+3
CMD ["/sbin/init"]
